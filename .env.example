# =============================================================================
# LynxTrip 根目录环境变量模板（复制为 .env 后填写，勿将 .env 提交到 Git）
# =============================================================================
#
# 使用步骤：
#   cp .env.example .env
#
# 后端（Spring Boot）启动时会自动加载本仓库根目录的 .env（见 RootDotenvLoader）：
#   - 优先：环境变量 LYNXTRIP_DOTENV_FILE=/绝对路径/.env
#   - 否则：当前工作目录下的 .env，或上一级目录的 .env（从 backend/ 启动也能读到根目录）
#   已存在于操作系统里的同名环境变量不会被 .env 覆盖。
#   直接：mvn -f backend/pom.xml spring-boot:run 即可，一般不必再手动 source .env。
#
# 前端（Vite）已通过 vite.config.js 的 envDir 指向本仓库根目录，可直接读取此处 VITE_*。
#
# 变量名与 backend/src/main/resources/application*.yml 中 ${VAR:默认值} 对应。
# =============================================================================

# -----------------------------------------------------------------------------
# Spring Boot
# -----------------------------------------------------------------------------
# 留空或 h2：使用 application.yml 默认内存 H2
# mysql：使用 application-mysql.yml + 下方 MYSQL_*
SPRING_PROFILES_ACTIVE=mysql

# 服务端口（application.yml: server.port）
PORT=8080

# -----------------------------------------------------------------------------
# MySQL（仅当 SPRING_PROFILES_ACTIVE=mysql）
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=lynxtrip
MYSQL_USER=root
MYSQL_PASSWORD=请改成你的密码

# -----------------------------------------------------------------------------
# JWT（application.yml → app.jwt）
# -----------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me-请生产环境改为长随机串
JWT_ISSUER=lynxtrip

# -----------------------------------------------------------------------------
# 前端 Vite（必须以 VITE_ 开头才会注入到 import.meta.env）
# -----------------------------------------------------------------------------
# 直连后端基址（不走代理时可用）；开发时一般用 Vite proxy /api 即可
VITE_API_BASE_URL=http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# 大模型 / AI API（占位：接入 OpenAI 兼容接口或其它云厂商时在此统一配置）
# 当前业务代码若未读取，可仍先填好，避免遗漏；后端/前端接入时映射到这些变量名即可。
# -----------------------------------------------------------------------------
# OpenAI 官方或兼容网关（如 Azure、国内兼容 OpenAI 格式的端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：通用别名（便于自研网关统一读取 OPENAI_* 或 LLM_*）
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=

# 可选：请求超时（毫秒），供你自己在代码里读取
LLM_TIMEOUT_MS=60000

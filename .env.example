# LynxTrip 环境变量模板
# 复制为 .env 并填写值，勿将 .env 提交到 Git
#
# 用法: cp .env.example .env
# 后端和前端会自动从仓库根目录加载 .env


# Spring Boot
# h2: 内存数据库, mysql: 使用MySQL
SPRING_PROFILES_ACTIVE=mysql

# 服务端口
PORT=8080

# MySQL (SPRING_PROFILES_ACTIVE=mysql时生效)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=lynxtrip
MYSQL_USER=root
MYSQL_PASSWORD=请改成你的密码

# JWT
JWT_SECRET=dev-only-change-me-请生产环境改为长随机串
JWT_ISSUER=lynxtrip

# 前端 Vite (必须以 VITE_ 开头)
# 后端地址
VITE_API_BASE_URL=http://127.0.0.1:8080

# AI API (OpenAI兼容接口)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通用别名 (可选)
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=

# 请求超时(毫秒)
LLM_TIMEOUT_MS=60000
